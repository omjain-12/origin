# ── AWS Bedrock Mantle (OpenAI-compatible) ───────────────────────────────────
API_KEY=your-bedrock-mantle-api-key
BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1

# Available ZAI GLM models (confirmed available via /v1/models)
PLANNING_MODELS=zai.glm-5, zai.glm-4.7
EXECUTION_MODELS_FAST=zai.glm-4.7-flash, zai.glm-4.7
EXECUTION_MODELS_FULL=zai.glm-5, zai.glm-4.7

# Active model selections used by the application
CHAT_MODEL=zai.glm-5
FAST_CHAT_MODEL=zai.glm-4.7-flash
EMBEDDING_MODEL=zai.glm-4.7

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=ramlaal
POSTGRES_USER=ramlaal
POSTGRES_PASSWORD=ramlaal_secret
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
