{
  "safety-guard": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"Write-Host 'Validating command safety...'\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "post-build-notify": {
    "enabled": false,
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"Write-Host 'Tool execution complete.'\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
